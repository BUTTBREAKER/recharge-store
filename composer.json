{
    "require": {
        "php": ">=8.5",
        "flightphp/container": "^1.3",
        "flightphp/core": "^3.19",
        "illuminate/support": "^12.47",
        "leafs/auth": "^5.0",
        "league/oauth2-google": "^5.0",
        "symfony/dotenv": "^7.4",
        "symfony/string": "^7.4"
    },
    "require-dev": {
        "carthage-software/mago": "^1.50",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.3",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/var-dumper": "^8.1"
    },
    "scripts": {
        "post-autoload-dump": "cp .env.example .env",
        "serve": "php -S localhost:61001 -t public",
        "format": ["mago format", "phpcbf"],
        "lint": [
            "mago lint",
            "mago analyze",
            "mago guard",
            "phpstan --memory-limit=1G",
            "phpcs"
        ],
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app"
        },
        "files": [
            "app/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "process-timeout": 0
    }
}
