{
    "require": {
        "php": ">=8.5",
        "flightphp/container": "^1.3",
        "flightphp/core": "^3.19",
        "illuminate/support": "^12.47",
        "leafs/auth": "^5.0",
        "symfony/dotenv": "^7.4",
        "symfony/string": "^7.4"
    },
    "require-dev": {
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/var-dumper": "^7.4"
    },
    "scripts": {
        "post-autoload-dump": "cp .env.example .env",
        "serve": "php -S localhost:61001 -t public",
        "format": "phpcbf",
        "lint": ["phpstan --memory-limit=1G", "phpcs"],
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "process-timeout": 0
    }
}
