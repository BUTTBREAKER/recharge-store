APP_NAME=FearSold

APP_LOCALE=es

BCRYPT_ROUNDS=12

DB_CONNECTION=mysql
DB_CHARSET=utf8
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=recharge_db
DB_USERNAME=root
DB_PASSWORD=

BINANCE_API_KEY=your_api_key
BINANCE_SECRET_KEY=your_secret_key
BINANCE_CALLBACK_URL=https://yourdomain.com/payment/binance/callback

ADMIN_USER=admin
ADMIN_PASS=admin123

TOKEN_SECRET=token_secret

# --- API (/api routes) ---
# CORS_ORIGIN: single browser origin allowed to call /api/* (preflight included).
# Default is the Next.js dev server; set your production frontend origin instead.
#CORS_ORIGIN=http://localhost:3000

# API_AUTH_STRICT: when true, every /api route requires a valid Bearer token (401
# otherwise). Default false = lenient mode, convenient for local frontend testing.
#API_AUTH_STRICT=true
